{
  "name": "@sns-growth-bridge/adapters-sns-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only SNS-AI → Canonical adapters. No JSONL transport, provider calls, or autonomy.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sns-growth-bridge/contracts": "*",
    "@sns-growth-bridge/scoring": "*",
    "@sns-growth-bridge/strategy": "*"
  }
}
