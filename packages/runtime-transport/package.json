{
  "name": "@sns-growth-bridge/runtime-transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only SNS-AI JSONL evidence transport. No network or writes.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sns-growth-bridge/adapters-sns-ai": "*",
    "@sns-growth-bridge/contracts": "*",
    "@sns-growth-bridge/identity-links": "*",
    "@sns-growth-bridge/scoring": "*",
    "@sns-growth-bridge/strategy": "*"
  }
}
